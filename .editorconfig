root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Corpus files are real WhatsApp lists: keep their whitespace exactly as pasted
[tests/**/Corpus/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false

[*.cs]
# File-scoped namespaces that mirror the folders
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true:warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# Explicit types; var only when the type is on the same line
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

# No primary constructors on classes
csharp_style_prefer_primary_constructors = false:warning
dotnet_diagnostic.IDE0290.severity = none

# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Null checks with patterns
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_prefer_not_pattern = true:warning

# Naming: constants PascalCase, private fields _camelCase
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Copy to .env and fill in the blanks: cp .env.example .env
# .env is git-ignored and docker compose reads it from this folder.
# Placeholders only: real values never go into Git.

# WAHA API key. WAHA requires it (X-Api-Key header) and the bot sends the same value.
# Generate one with: openssl rand -hex 32
WAHA_API_KEY=

# Webhook signature. WAHA signs every webhook with this key (HMAC-SHA512 of the body, in the
# X-Webhook-Hmac header) and the bot answers 401 to any webhook whose signature does not match.
# The bot refuses to start with less than 32 characters.
# Generate one with: openssl rand -hex 32
WAHA_WEBHOOK_HMAC_KEY=

# Six Labors license key. ImageSharp 4 fails a Release build without it, and the Docker image
# is a Release build. Get the free key for open source and small projects at
# https://licensing.sixlabors.com, scoped to the PeladaBot assembly. Debug builds only warn.
SIXLABORS_LICENSE_KEY=

# Login for the WAHA dashboard and Swagger (http://localhost:3000/dashboard).
# WAHA rejects common passwords (admin, waha, 123...) and generates a random one instead.
# Generate one with: openssl rand -hex 16
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# WAHA publishes one image per CPU architecture (see docker-compose.yml):
#   -arm  -> devlikeapro/waha:gows-arm-<version> (arm64: Mac with Apple Silicon)
#   empty -> devlikeapro/waha:gows-<version>     (amd64: Intel or AMD)
WAHA_ARCH_SUFFIX=-arm

# Bot: the group the bot answers in and who the president is, in WAHA's id
# format. Groups end in @g.us; people in @c.us (phone) or @lid. In the test group the
# president is you. Leave them empty until the number is paired: WAHA starts alone and
# the bot refuses to start, saying which value is missing.
BOT_GROUP_ID=
BOT_PRESIDENT_ID=
BOT_PRESIDENT_NAME=Presidente
